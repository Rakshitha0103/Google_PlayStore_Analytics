   "source": [
    "# Example mapping of category → region\n",
    "region_map = {\n",
    "    top5['Category'].iloc[0]: 'United States',\n",
    "    top5['Category'].iloc[1]: 'India',\n",
    "    top5['Category'].iloc[2]: 'United Kingdom',\n",
    "    top5['Category'].iloc[3]: 'Germany',\n",
    "    top5['Category'].iloc[4]: 'Australia'\n",
    "}\n",
    "\n",
    "# Create an explicit copy before assigning a new column\n",
    "top5 = top5.copy()\n",
    "top5.loc[:, 'Country'] = top5['Category'].map(region_map)"
   ]
