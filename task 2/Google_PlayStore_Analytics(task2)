    "\n",
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "from datetime import datetime\n",
    "import pytz\n",
    "\n",
    "# --- Ensure 'df' from previous tasks is already loaded and cleaned ---\n",
    "# (We assume df already exists; if not, reload and clean like in Task 1)\n",
    "\n",
    "# 1️ Create a safe copy and drop rows missing required values\n",
    "bubble_df = df.dropna(subset=['Size', 'Rating', 'Installs', 'Type']).copy()\n",
    "\n",
    "# 2️ Fill missing 'Type' values safely\n",
    "bubble_df.loc[:, 'Type'] = bubble_df['Type'].fillna('Unknown')\n",
    "\n",
    "# 3️ Define time window (6 AM → 8 AM IST)\n",
    "ist = pytz.timezone('Asia/Kolkata')\n",
    "now_ist = datetime.now(ist)\n",
    "\n",
    "if 6 <= now_ist.hour < 8:\n",
    "    # 4️ Build an interactive bubble chart with Plotly\n",
    "    fig = px.scatter(\n",
    "        bubble_df,\n",
    "        x=\"Size\",\n",
    "        y=\"Rating\",\n",
    "        size=\"Installs\",\n",
    "        color=\"Type\",\n",
    "        hover_name=\"App\",\n",
    "        title=\"App Size vs Rating vs Installs (Bubble Representation)\",\n",
    "        size_max=50,\n",
    "        color_discrete_sequence=px.colors.qualitative.Set2,\n",
    "        template=\"plotly_white\",\n",
    "        opacity=0.7\n",
    "    )\n",
    "\n",
    "    # 5️ Beautiful layout tweaks\n",
    "    fig.update_layout(\n",
    "        title_font_size=18,\n",
    "        xaxis_title=\"App Size (MB)\",\n",
    "        yaxis_title=\"Rating\",\n",
    "        legend_title=\"App Type\",\n",
    "        margin=dict(l=10, r=10, t=50, b=10)\n",
    "    )\n",
    "\n",
    "    # Optional: Limit y-axis to better focus on 0–5 range ratings\n",
    "    fig.update_yaxes(range=[0, 5])\n",
    "\n",
    "    fig.show()\n",
    "\n",
    "else:\n",
    "    print(\"⏰ Bubble chart visible only between 6 AM and 8 AM IST.\")"
